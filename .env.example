# --- Django Backend Environment Configuration (Production Example) ---

# Security Settings
SECRET_KEY=your-super-secret-production-key-change-this-now
DEBUG=False
ALLOWED_HOSTS=your-backend-domain.onrender.com,your-custom-backend-domain.com

# Database Connection (PostgreSQL)
# Render or Railway will automatically inject the DATABASE_URL variable.
# Format: postgres://username:password@host:port/database_name
DATABASE_URL=postgres://user:password@host:5432/database_name

# CORS Configuration
# Set to False in production to protect your endpoints from malicious websites.
CORS_ALLOW_ALL_ORIGINS=False
# Comma-separated list of your allowed frontend URL origins
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.vercel.app

# CSRF Trusted Origins
# Comma-separated list of trusted origins for secure Django forms / admin access
CSRF_TRUSTED_ORIGINS=https://your-backend-domain.onrender.com,https://your-frontend-domain.vercel.app

# Celery / Redis (Optional, if using Celery async workers)
CELERY_BROKER_URL=redis://your-redis-host:6379/1
CELERY_RESULT_BACKEND=redis://your-redis-host:6379/2
